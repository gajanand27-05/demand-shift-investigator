# Copy to .env and fill in. .env is gitignored; never commit real values.
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key

# Meterless Nightshift (primary AI provider). URL + Runtime token from the Nightshift Console.
MODEL_BASE_URL=http://<nightshift-host>:8088/v1
MODEL_API_KEY=your-nightshift-runtime-token
NEMOTRON_MODEL=local-runtime/nemotron-3.5-lightning-30b-a3b
METERLESS_APP=open-agents-hackathon
# Optional: fallback lane used on the last retry (NVIDIA cloud via Nightshift), per-role lanes, budgets
NEMOTRON_FALLBACK_MODEL=nvidia/nvidia/nemotron-3-ultra-550b-a55b
# NEMOTRON_MODEL_CRITIC=...
LLM_MAX_TOKENS=3000
LLM_TIMEOUT_S=180
