# Copy to .env and fill in. .env is gitignored; never commit real values.
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key

# Meterless Nightshift (primary AI provider). URL + Runtime token from the Nightshift Console.
MODEL_BASE_URL=http://<nightshift-host>:8088/v1
MODEL_API_KEY=your-nightshift-runtime-token
NEMOTRON_MODEL=nvidia/nvidia/nemotron-3.5-bolt-e4b
METERLESS_APP=open-agents-hackathon
# Optional per-role Nemotron lanes (deep lane for planner/critic/reporter, fast lane for the analyst)
NEMOTRON_MODEL_PLANNER=nvidia/nvidia/nemotron-3-ultra-550b-a55b
NEMOTRON_MODEL_CRITIC=nvidia/nvidia/nemotron-3-ultra-550b-a55b
NEMOTRON_MODEL_REPORTER=nvidia/nvidia/nemotron-3-ultra-550b-a55b
LLM_MAX_TOKENS=4000
